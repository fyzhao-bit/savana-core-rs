[Unit]
Description=Savana effect executor V2
Requires=savana-execd.socket
After=local-fs.target network-online.target

[Service]
Type=simple
User=savana-exec
Group=savana-exec
ExecStart=/usr/libexec/savana/savana-execd --config /etc/savana/execd-bootstrap-v2.json
Restart=on-failure
RestartSec=1s
TimeoutStopSec=30s
UMask=0077
RuntimeDirectory=savana/execd
RuntimeDirectoryMode=0711
StateDirectory=savana/execd
StateDirectoryMode=0700
ReadOnlyPaths=/etc/savana
ReadWritePaths=/var/lib/savana/execd /run/savana/execd
InaccessiblePaths=/var/lib/savana/kerneld /var/lib/savana/agentd /var/lib/savana/approvald
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
DevicePolicy=closed
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RemoveIPC=yes
KeyringMode=private
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@clock @debug @module @mount @obsolete @privileged @raw-io @reboot @swap
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SocketBindDeny=any
LoadCredentialEncrypted=executor-server-v2.seed:/etc/savana/credentials/execd/executor-server-v2.seed.cred
LoadCredentialEncrypted=execd-boot-v2.id:/etc/savana/credentials/shared/execd-boot-v2.id.cred
LoadCredentialEncrypted=effect-receipt-v2.seed:/etc/savana/credentials/execd/effect-receipt-v2.seed.cred
LoadCredentialEncrypted=execution-seal-v2.key:/etc/savana/credentials/execd/execution-seal-v2.key.cred
LoadCredentialEncrypted=journal-encryption-v2.key:/etc/savana/credentials/execd/journal-encryption-v2.key.cred
LoadCredentialEncrypted=journal-anchor-authentication-v2.key:/etc/savana/credentials/execd/journal-anchor-authentication-v2.key.cred
LoadCredentialEncrypted=connector-descriptor-v2.seed:/etc/savana/credentials/execd/connector-descriptor-v2.seed.cred
LoadCredentialEncrypted=provider-tls-private-key-v2.der:/etc/savana/credentials/execd/provider-tls-private-key-v2.der.cred

[Install]
WantedBy=savana-kernel.target
