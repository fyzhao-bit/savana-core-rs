[Unit]
Description=Savana hardware approval authority V2
Requires=savana-approvald-agent.socket savana-approvald-ingress.socket savana-approvald-admin.socket savana-approvald-http.socket
After=local-fs.target

[Service]
Type=simple
User=savana-approval
Group=savana-approval
ExecStart=/usr/libexec/savana/savana-approvald --config /etc/savana/approvald-bootstrap-v2.json
Restart=on-failure
RestartSec=1s
TimeoutStopSec=15s
UMask=0077
RuntimeDirectory=savana/approvald
RuntimeDirectoryMode=0711
StateDirectory=savana/approvald
StateDirectoryMode=0700
ReadOnlyPaths=/etc/savana
ReadWritePaths=/var/lib/savana/approvald /run/savana/approvald
InaccessiblePaths=/var/lib/savana/kerneld /var/lib/savana/agentd /var/lib/savana/execd
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
DevicePolicy=closed
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RemoveIPC=yes
KeyringMode=private
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@clock @debug @module @mount @obsolete @privileged @raw-io @reboot @swap
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_UNIX AF_INET
IPAddressDeny=any
IPAddressAllow=localhost
SocketBindDeny=any
LoadCredentialEncrypted=approvald-boot-v2.id:/etc/savana/credentials/shared/approvald-boot-v2.id.cred
LoadCredentialEncrypted=approval-server-v2.seed:/etc/savana/credentials/approvald/approval-server-v2.seed.cred
LoadCredentialEncrypted=approval-settlement-v2.seed:/etc/savana/credentials/approvald/approval-settlement-v2.seed.cred
LoadCredentialEncrypted=approval-state-encryption-v2.key:/etc/savana/credentials/approvald/approval-state-encryption-v2.key.cred
LoadCredentialEncrypted=approval-anchor-authentication-v2.key:/etc/savana/credentials/approvald/approval-anchor-authentication-v2.key.cred

[Install]
WantedBy=savana-kernel.target
