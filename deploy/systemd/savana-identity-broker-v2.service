[Unit]
Description=Savana restricted native peer measurement broker
Requires=savana-identity-broker-v2.socket
After=local-fs.target

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/libexec/savana/savana-linux-identity-broker
UMask=0077
Restart=on-failure
RestartSec=2s
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_SYS_PTRACE
AmbientCapabilities=
ProtectProc=default
ProcSubset=pid
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
DevicePolicy=closed
InaccessiblePaths=-/var/lib/savana -/etc/savana/credentials
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
SocketBindDeny=any
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@clock @debug @module @mount @obsolete @raw-io @reboot @swap
SystemCallErrorNumber=EPERM
LimitNOFILE=128
TasksMax=1
MemoryMax=128M
TimeoutStopSec=5s
