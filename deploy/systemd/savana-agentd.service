[Unit]
Description=Savana agent control and browser authority V2
Requires=savana-agentd-control.socket savana-agentd-jarvis-http.socket savana-agentd-agent-http.socket
After=local-fs.target network-online.target savana-kerneld-agent.socket savana-approvald-agent.socket

[Service]
Type=simple
User=savana-agent
Group=savana-agent
ExecStart=/usr/libexec/savana/savana-agentd --config /etc/savana/agentd-bootstrap-v2.json
ExecStartPre=/usr/libexec/savana/savana-systemd-agentd-network-policy-v2 validate /etc/savana/agentd-bootstrap-v2.json
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=1s
TimeoutStopSec=30s
UMask=0077
RuntimeDirectory=savana/agentd
RuntimeDirectoryMode=0711
StateDirectory=savana/agentd
StateDirectoryMode=0700
ReadOnlyPaths=/etc/savana
ReadWritePaths=/var/lib/savana/agentd /run/savana/agentd
InaccessiblePaths=/var/lib/savana/kerneld /var/lib/savana/approvald /var/lib/savana/execd
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
DevicePolicy=closed
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RemoveIPC=yes
KeyringMode=private
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@clock @debug @module @mount @obsolete @privileged @raw-io @reboot @swap
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SocketBindDeny=any
IPAddressDeny=any
LoadCredentialEncrypted=agent-kernel-v2.seed:/etc/savana/credentials/agentd/agent-kernel-v2.seed.cred
LoadCredentialEncrypted=agent-approval-v2.seed:/etc/savana/credentials/agentd/agent-approval-v2.seed.cred
LoadCredentialEncrypted=task-state-encryption-v2.key:/etc/savana/credentials/agentd/task-state-encryption-v2.key.cred
LoadCredentialEncrypted=task-anchor-authentication-v2.key:/etc/savana/credentials/agentd/task-anchor-authentication-v2.key.cred
LoadCredentialEncrypted=agentd-boot-v2.id:/etc/savana/credentials/shared/agentd-boot-v2.id.cred
LoadCredentialEncrypted=kerneld-boot-v2.id:/etc/savana/credentials/shared/kerneld-boot-v2.id.cred
LoadCredentialEncrypted=approvald-boot-v2.id:/etc/savana/credentials/shared/approvald-boot-v2.id.cred
LoadCredentialEncrypted=machine-boot-v2.id:/etc/savana/credentials/shared/machine-boot-v2.id.cred
LoadCredentialEncrypted=jarvis-boot-v2.id:/etc/savana/credentials/shared/jarvis-boot-v2.id.cred
LoadCredentialEncrypted=planner-root-v2.der:/etc/savana/credentials/agentd/planner-root-v2.der.cred
LoadCredentialEncrypted=planner-client-v2.der:/etc/savana/credentials/agentd/planner-client-v2.der.cred
LoadCredentialEncrypted=planner-client-v2.pk8:/etc/savana/credentials/agentd/planner-client-v2.pk8.cred
LoadCredentialEncrypted=mapper-root-v2.der:/etc/savana/credentials/agentd/mapper-root-v2.der.cred
LoadCredentialEncrypted=mapper-client-v2.der:/etc/savana/credentials/agentd/mapper-client-v2.der.cred
LoadCredentialEncrypted=mapper-client-v2.pk8:/etc/savana/credentials/agentd/mapper-client-v2.pk8.cred

[Install]
WantedBy=savana-kernel.target
