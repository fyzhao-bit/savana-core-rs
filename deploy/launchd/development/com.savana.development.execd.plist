<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.savana.development.execd</string>
  <key>Program</key>
  <string>/Library/PrivilegedHelperTools/SavanaDevelopment/savana-execd</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Library/PrivilegedHelperTools/SavanaDevelopment/savana-execd</string>
    <string>--config</string>
    <string>/Library/Application Support/Savana/Development/config/execd-bootstrap-v2.json</string>
  </array>
  <key>UserName</key>
  <string>_savana_exec_dev</string>
  <key>GroupName</key>
  <string>_savana_exec_dev</string>
  <key>InitGroups</key>
  <true/>
  <key>EnvironmentVariables</key>
  <dict>
    <key>SAVANA_AUTHORITY_CLASS</key>
    <string>development</string>
  </dict>
  <key>Sockets</key>
  <dict>
    <key>savana-kernel-executor</key>
    <dict>
      <key>SockPathName</key>
      <string>/Library/Application Support/Savana/Development/run/execd/kerneld/execd.sock</string>
      <key>SockPathMode</key>
      <integer>432</integer>
      <key>SockPathOwner</key>
      <string>_savana_exec_dev</string>
      <key>SockPathGroup</key>
      <string>_savana_kernel_exec_dev</string>
      <key>SockType</key>
      <string>stream</string>
    </dict>
  </dict>
  <key>KeepAlive</key>
  <true/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>/Library/Logs/Savana/Development/execd.log</string>
  <key>StandardErrorPath</key>
  <string>/Library/Logs/Savana/Development/execd.error.log</string>
</dict>
</plist>
