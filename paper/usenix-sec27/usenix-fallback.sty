%% usenix-fallback.sty
%%
%% A minimal stand-in for the official USENIX style file
%% (`usenix-2020-09.sty`, distributed by USENIX at
%% https://www.usenix.org/conferences/author-resources/paper-templates).
%% It reproduces the essential page geometry (US letter, two columns,
%% 10pt Times, 7in x 9in text block, 0.33in column gap) and heading
%% fonts so that the project compiles before the official file is
%% dropped in.  It is NOT the official style and must not be used for
%% the actual submission: copy `usenix-2020-09.sty` next to main.tex and
%% this file is ignored automatically.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{usenix-fallback}[2026/09/03 fallback approximation of the USENIX layout]

\RequirePackage{times}
\RequirePackage[letterpaper,
  textwidth=7in, textheight=9in,
  columnsep=0.33in,
  hcentering, vcentering]{geometry}

\setlength{\parindent}{1pc}
\setlength{\parskip}{0pt plus 1pt}

% Avoid the article class's narrow quotation-style abstract in two columns.
\renewenvironment{abstract}{\subsection*{Abstract}}{\par}

% Heading fonts approximating the USENIX defaults.
\renewcommand\section{\@startsection{section}{1}{\z@}%
  {-3.5ex \@plus -1ex \@minus -.2ex}%
  {2.3ex \@plus.2ex}%
  {\reset@font\Large\bfseries\raggedright}}
\renewcommand\subsection{\@startsection{subsection}{2}{\z@}%
  {-3.25ex\@plus -1ex \@minus -.2ex}%
  {1.5ex \@plus .2ex}%
  {\reset@font\large\bfseries\raggedright}}
\renewcommand\subsubsection{\@startsection{subsubsection}{3}{\z@}%
  {-3.25ex\@plus -1ex \@minus -.2ex}%
  {1.5ex \@plus .2ex}%
  {\reset@font\normalsize\bfseries\raggedright}}

% USENIX papers carry no page numbers in the submission template.
\pagestyle{empty}

\endinput
