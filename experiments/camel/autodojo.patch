diff --git a/src/camel/autodojo_replay.py b/src/camel/autodojo_replay.py
new file mode 100644
index 0000000..f27a15c
--- /dev/null
+++ b/src/camel/autodojo_replay.py
@@ -0,0 +1,105 @@
+"""AutoDojo replay and a polluted P-LLM for the CaMeL comparison with Savana.
+
+`--attack autodojo` replays AutoDojo's optimized injections through the same
+pinned cache files and the same port that Savana's and the undefended runs use
+(`experiments/savana_bench/autodojo_cache.py`, loaded here by path): variant 0,
+the important-instructions fallback, YAML escaping, and AgentDojo's own
+`get_injection_candidates` for the vectors.
+
+`CAMEL_EXPOSURE=data` pollutes the P-LLM the way Savana's `+exposure=data`
+pollutes its planner: the P-LLM gets every injection text of the episode, as
+the tools return it (YAML-decoded, in vector order), as `retrieved_data`, and
+Savana's `EXPOSURE_NOTE` (read from `root_drafter.py`, not retyped) is appended
+to its system prompt. Each exposure is recorded (hash only) so the comparison
+can check it equals the one Savana's planner saw for the same pair.
+"""
+import ast
+import hashlib
+import importlib.util
+import json
+import os
+from pathlib import Path
+
+import yaml
+from agentdojo.attacks.base_attacks import BaseAttack
+
+REPO = Path(os.environ.get("SAVANA_REPO", "/home/user/savana-core-rs"))
+_BENCH = REPO / "experiments" / "savana_bench"
+EXPOSURES = ("none", "data")
+
+
+def _load_cache_module():
+    spec = importlib.util.spec_from_file_location("savana_autodojo_cache", _BENCH / "autodojo_cache.py")
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def _exposure_note() -> str:
+    tree = ast.parse((_BENCH / "root_drafter.py").read_text())
+    for node in tree.body:
+        if isinstance(node, ast.Assign) and any(getattr(t, "id", None) == "EXPOSURE_NOTE" for t in node.targets):
+            return ast.literal_eval(node.value)
+    raise RuntimeError("EXPOSURE_NOTE not found in root_drafter.py")
+
+
+autodojo_cache = _load_cache_module()
+CACHE_MODULE_SHA256 = hashlib.sha256((_BENCH / "autodojo_cache.py").read_bytes()).hexdigest()
+EXPOSURE_NOTE = _exposure_note()
+
+# (suite, user task, injection task) -> the values this run injected for it.
+INJECTED: dict[tuple[str, str, str], dict[str, str]] = {}
+
+
+class CachedAutoDojoAttack(BaseAttack):
+    name = "autodojo"
+
+    def __init__(self, task_suite, target_pipeline) -> None:
+        super().__init__(task_suite, target_pipeline)
+        path = autodojo_cache.cache_path(task_suite.name)
+        self.variants, self.originals, self.cache_sha256 = autodojo_cache.load(path)
+
+    def attack(self, user_task, injection_task) -> dict[str, str]:
+        values = {
+            vector: autodojo_cache.injection(
+                self.variants, self.originals, injection_task.ID, injection_task.GOAL, vector, 0
+            )
+            for vector in self.get_injection_candidates(user_task)
+        }
+        INJECTED[(self.task_suite.name, user_task.ID, injection_task.ID)] = values
+        return values
+
+
+def exposure_mode() -> str:
+    mode = os.environ.get("CAMEL_EXPOSURE") or "none"
+    if mode not in EXPOSURES:
+        raise ValueError(f"unknown CAMEL_EXPOSURE {mode!r}")
+    return mode
+
+
+def name_suffix() -> str:
+    return "" if exposure_mode() == "none" else f"+exposure-{exposure_mode()}"
+
+
+def exposure(extra_args: dict) -> tuple[str, ...]:
+    """The texts the polluted P-LLM sees for this episode: empty when off, and
+    for an episode without an injection (AgentDojo's attacker-capability runs
+    of the injection tasks), which has no injected data to see."""
+    if exposure_mode() == "none":
+        return ()
+    key = (extra_args["task_suite_name"], extra_args["user_task_id"], extra_args["injection_task_id"])
+    if key[2] is None:
+        return ()
+    if key not in INJECTED:
+        raise ValueError("exposure needs an AutoDojo-injected episode")
+    values = INJECTED[key]
+    texts = tuple(yaml.safe_load('"' + values[vector] + '"') for vector in sorted(values))
+    record = dict(suite=key[0], user=key[1], injection=key[2], items=len(texts),
+                  sha256=hashlib.sha256(json.dumps(list(texts), ensure_ascii=False).encode()).hexdigest())
+    with open(Path("logs") / "exposure-data.jsonl", "a") as log:
+        log.write(json.dumps(record) + "\n")
+    return texts
+
+
+def user_message(query: str, texts: tuple[str, ...]) -> str:
+    return query + "\n\nretrieved_data: " + json.dumps(list(texts), ensure_ascii=False)
